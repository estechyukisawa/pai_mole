   </model>
    <model name="gantry">   
        <link name="base">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
            <mass>0.5</mass>
            <inertia>
                <ixx>0.1</ixx>
                <iyy>0.1</iyy>
                <izz>0.1</izz>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyz>0</iyz>
            </inertia>
        </inertial>
        </link>
        <joint name="base_fix" type="fixed">
            <parent>world</parent><child>base</child>
        </joint>

        <link name="carriage_x"> 
        <pose>0 0 0 0 0 0</pose>
        <inertial>
            <mass>0.5</mass>
            <inertia>
                <ixx>0.1</ixx>
                <iyy>0.1</iyy>
                <izz>0.1</izz>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyz>0</iyz>
            </inertia>
        </inertial>
        </link>
        <joint name="x_joint" type="prismatic">
            <parent>base</parent><child>carriage_x</child>
            <axis><xyz>1 0 0</xyz>
            <limit><lower>-0.15</lower><upper>0.30</upper></limit>
            </axis>
        </joint>

        <link name="carriage_y">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
            <mass>0.5</mass>
            <inertia>
                <ixx>0.1</ixx>
                <iyy>0.1</iyy>
                <izz>0.1</izz>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyz>0</iyz>
            </inertia>
        </inertial>
        </link>
        <joint name="y_joint" type="prismatic">
            <parent>carriage_x</parent><child>carriage_y</child>
            <axis><xyz>0 1 0</xyz>
            <limit><lower>-0.15</lower><upper>0.15</upper></limit>
            </axis>
        </joint>

    <link name="hammer">
        <collision name="collision">
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.04</length>
                </cylinder>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.04</length>
                 </cylinder>
            </geometry>
            <material>
                <ambient>0 0 1.0 1</ambient>
                <diffuse>0 0 1.0 1</diffuse>
            </material>
        </visual>
        <pose>0 0 0.27 0 0 0</pose>
        <inertial>
            <mass>0.3</mass>
            <inertia>
               <ixx>0.0002</ixx>
               <iyy>0.0002</iyy>
               <izz>0.0002</izz>
               <ixy>0</ixy>
               <ixz>0</ixz>
               <iyz>0</iyz>
            </inertia>
        </inertial>
    </link>
    <joint name="z_joint" type="prismatic">
        <parent>carriage_y</parent><child>hammer</child>
        <axis><xyz>0 0 1</xyz>
        <limit><lower>-0.15</lower><upper>0.0</upper></limit>
        </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>x_joint</joint_name>
        <topic>/gantry/x</topic>
        <p_gain>1000</p_gain>
        <d_gain>80</d_gain>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>y_joint</joint_name>
        <topic>/gantry/y</topic>
        <p_gain>1000</p_gain>
        <d_gain>80</d_gain>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>z_joint</joint_name>
        <topic>/gantry/z</topic>
        <p_gain>1000</p_gain>
        <d_gain>80</d_gain>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
    </plugin>

</model>

   <model name="top_camera">
        <static>true</static>
        <link name="link">
         <pose>0 0 0.8 0 1.5708 0</pose>
         <sensor name="camera" type="camera">
            <topic>/top_camera/image</topic>
            <update_rate>10</update_rate>
            <always_on>true</always_on><visualize>true</visualize>
            <camera>
                <horizontal_fov>0.8</horizontal_fov>
                <image><width>320</width><height>320</height><format>R8G8B8</format></image>
                <clip><near>0.05</near><far>3</far></clip>
            </camera>
         </sensor>
        </link>
   </model>

   </world>
</sdf>